# Configuración del Backend TecleoLlave-Adapt
APP_NAME=TECLEOLLAVE-ADAPT
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Base de Datos y Almacenamiento de Modelos (dejar vacío en Docker para usar volumen db_data)
# DB_PATH=/app/data/tecleollave.db
# MODELS_DIR=/app/data/models

# Seguridad JWT
SECRET_KEY=cambiar-por-un-secreto-seguro-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Parámetros Biométricos
PHRASE="La seguridad protege la información"
PHRASE_LENGTH=35
N_FEATURES=100