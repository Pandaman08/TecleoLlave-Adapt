ADAPT_MIN_CANDIDATE_SAMPLES=10
ADAPT_CANDIDATE_WINDOW_SIZE=50
ADAPT_MAX_FAR_DEGRADATION=0.0
ADAPT_MAX_FRR_DEGRADATION=0.02
ADAPT_MAX_EER_DEGRADATION=0.0
ADAPT_MIN_PRECISION_DELTA=-0.01
ADAPT_MIN_RECALL_DELTA=-0.01
ADAPT_REQUIRE_ALL_CONSTRAINTS=true